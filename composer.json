{
    "name": "rajanvijayan/ai-comment-moderator",
    "description": "AI-powered comment moderation for WordPress using Groq, Google Gemini or OpenAI.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Rajan Vijayan"
        }
    ],
    "keywords": ["wordpress", "comments", "moderation", "spam", "groq", "llm", "ai"],
    "autoload": {
        "psr-4": {
            "AICommentModerator\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4"
        }
    }
}
